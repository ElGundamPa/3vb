# Example environment variables for deployment
GOOGLE_SHEETS_WEBHOOK=https://script.google.com/macros/s/REPLACE_WITH_YOUR_ID/exec
# Do NOT store the real secret in the repo. Generate a long random secret and set it in Vercel (APPS_SCRIPT_SECRET).
# Example to generate locally: openssl rand -base64 32
APPS_SCRIPT_SECRET=replace_with_a_long_random_secret
